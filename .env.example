# 프로바이더 선택: closedrouter (기본) | direct
PROVIDER=closedrouter

# --- ClosedRouter 모드 (PROVIDER=closedrouter) ---
CLOSEDROUTER_BASE_URL=https://router.example.com/v1
CLOSEDROUTER_API_KEY=your-invoke-token

# --- Direct 모드 (PROVIDER=direct) ---
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-key

# 평가에 사용할 모델
EVAL_MODEL=claude-sonnet-4-5-20250929

# 생성에 사용할 모델
GENERATION_MODEL=claude-sonnet-4-5-20250929
